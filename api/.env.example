# Techieficial API settings. Copy to api/.env for local runs; on the host, set them as secrets.
# Never commit api/.env. Names and comments only: no real values belong in this file.
# Empty values count as "not set". The API checks every value at startup and stops on a bad one.

# Port the API listens on. Default 3001.
PORT=

# Browser origins allowed to call the API, comma separated. Default http://localhost:3000.
# Production: https://techieficial.com
CORS_ORIGINS=

# Log level: info (default), debug or silent. Logs are JSON lines without request bodies.
LOG_LEVEL=

# Supabase project URL (Project Settings > API). When empty, the API keeps data in memory
# (lost on restart), which is only for local development and tests. Required in production.
SUPABASE_URL=

# Supabase anon (public) key. Used with each portal user's own token so row-level security applies.
SUPABASE_ANON_KEY=

# Supabase service role key. SECRET: bypasses row-level security. Server only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT secret (Project Settings > API > JWT settings). SECRET. Verifies portal tokens.
# At least 32 characters. Required in production. When empty, every portal request gets 401.
SUPABASE_JWT_SECRET=

# CRM inbound webhook for website leads (docs/CRM_SETUP.md). SECRET: keep out of the repo.
# When empty, leads are stored with crm_sync_status "skipped" and not forwarded.
CRM_WEBHOOK_URL=

# Upstash Redis REST URL and token for shared rate limits and session cache (wired up in B4).
# Set both or neither. The token is a SECRET.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry DSN for error reports (wired up in B4). Optional.
SENTRY_DSN=
