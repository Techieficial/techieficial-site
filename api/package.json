{
  "name": "techieficial-api",
  "private": true,
  "version": "0.1.0",
  "description": "Backend API for the client portal, lead log and AI assistant (local first).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "6.8.0",
    "@supabase/supabase-js": "2.119.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "jose": "6.2.18",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.6.2",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "22.20.7",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "npm run typecheck && eslint .",
    "test": "vitest run",
    "openapi": "npm run build && node dist/scripts/write-openapi.js",
    "check": "npm run lint && npm test && npm run openapi"
  }
}
