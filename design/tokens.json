{
  "$description": "Techieficial design tokens. Single source of truth for colours, type, radius, shadow and motion. Edit here, then run `npm run tokens` to regenerate app/tokens.css. `npm run check` fails if the two drift.",
  "color": {
    "light": {
      "bg": "#ffffff",
      "surface": "#f6f7fa",
      "surface-2": "#eef0f5",
      "rule": "#e2e5ec",
      "ink": "#0b0c14",
      "muted": "#596074",
      "prose": "#2b3040",
      "accent": "#6d4aff",
      "accent-hover": "#5b3be8",
      "accent-text": "#5636e0",
      "headline-from": "#5636e0",
      "headline-to": "#8b6bff",
      "glow": "rgba(109, 74, 255, 0.18)",
      "shadow": "rgba(11, 12, 20, 0.12)",
      "on-accent": "#ffffff"
    },
    "dark": {
      "bg": "#0a0b14",
      "surface": "#12131f",
      "surface-2": "#191b2b",
      "rule": "#24263a",
      "ink": "#f4f5fa",
      "muted": "#9ca3b8",
      "prose": "#d5d9e5",
      "accent": "#6d4aff",
      "accent-hover": "#5b3be8",
      "accent-text": "#a99bff",
      "headline-from": "#b3a4ff",
      "headline-to": "#e4deff",
      "glow": "rgba(109, 74, 255, 0.32)",
      "shadow": "rgba(0, 0, 0, 0.6)",
      "on-accent": "#ffffff"
    },
    "service": {
      "$description": "5 shades of the accent for the wheel and chips. Mirrors siteConfig.serviceColors (a unit test keeps them equal).",
      "marketing-automation": "#6D4AFF",
      "paid-ads": "#B9A9FF",
      "ai-video": "#3A20B0",
      "ai-agents": "#9C86FF",
      "training": "#4A2BD6"
    }
  },
  "font": {
    "sans": "Inter 400/500/600 (body), self-hosted via next/font",
    "display": "Space Grotesk 600/700 (headings), self-hosted via next/font"
  },
  "text": {
    "display": "clamp(2.5rem, 1.6rem + 3.6vw, 4.5rem)",
    "h1": "clamp(2.25rem, 1.6rem + 2.6vw, 3.75rem)",
    "h2": "clamp(1.9rem, 1.4rem + 2vw, 3rem)",
    "h3": "clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem)",
    "lead": "clamp(1.0625rem, 1rem + 0.3vw, 1.25rem)"
  },
  "radius": {
    "$description": "Reference values in use today (Tailwind classes). Pills for buttons and tags, 2xl/3xl for cards and panels.",
    "pill": "9999px (rounded-full)",
    "card": "1rem (rounded-2xl)",
    "panel": "1.5rem (rounded-3xl)",
    "control": "0.75rem (rounded-xl)"
  },
  "space": {
    "$description": "Tailwind 4px scale. Section rhythm and page width in use today.",
    "section-y": "5rem mobile, 7rem desktop (py-20 md:py-28)",
    "container": "1240px max, 16px gutter mobile, 24px from sm (px-4 sm:px-6)"
  },
  "shadow": {
    "button": "0 10px 30px -14px var(--glow)",
    "button-hover": "0 14px 36px -14px var(--glow)"
  },
  "motion": {
    "ease-out-expo": "cubic-bezier(0.16, 1, 0.3, 1)",
    "fast": "300ms (hover, press)",
    "reveal": "700ms (fade-up on scroll)",
    "wheel-turn": "60s per turn, paused with prefers-reduced-motion",
    "rule": "Every animation stops or becomes instant with prefers-reduced-motion"
  }
}
