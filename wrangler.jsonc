{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "techieficial-site",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "techieficial-site"
    }
  ],
  // Per-minute rate limits for /api/lead and /api/callme, shared across Worker instances (lib/leadHandler.ts).
  // namespace_id is any number unique in the Cloudflare account; no dashboard setup is needed.
  "ratelimits": [
    { "name": "LEAD_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 4, "period": 60 } },
    { "name": "CALLME_PHONE_LIMITER", "namespace_id": "1002", "simple": { "limit": 2, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  }
}
