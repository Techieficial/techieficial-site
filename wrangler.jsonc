{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "techieficial-site",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "techieficial-site"
    }
  ],
  // Form spam limits shared by every Worker instance (lib/leadHandler.ts). Period must be 10 or 60 seconds.
  // namespace_id is any number unique within the Cloudflare account.
  "ratelimits": [
    { "name": "LEAD_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "CALLME_PHONE_LIMITER", "namespace_id": "1002", "simple": { "limit": 2, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  }
}
