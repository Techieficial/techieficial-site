# Copy to .env.local for local development. Never commit real values.
#
# In Cloudflare (Workers & Pages > techieficial-site > Settings):
#   NEXT_PUBLIC_* values are BUILD variables (Build > Variables and secrets), because they are baked into the pages at build time.
#   The others are runtime SECRETS (Variables and Secrets, type "Secret").

# --- Runtime secrets (server only) ---
# Values: see docs/CRM_SETUP.md (the webhook URLs themselves are kept out of the repo).
# CRM inbound webhook that receives every form submission (/api/lead).
CRM_WEBHOOK_URL=
# Webhook that triggers the AI outbound "call me" demo (/api/callme). Falls back to CRM_WEBHOOK_URL.
CRM_CALLME_WEBHOOK_URL=
# Cloudflare Turnstile secret key (spam protection on forms).
TURNSTILE_SECRET_KEY=

# --- Build variables (public, shown in the browser) ---
# Optional override of the business email (default hello@techieficial.com, in site.config.ts).
NEXT_PUBLIC_CONTACT_EMAIL=
# Live AI receptionist demo number in international format, e.g. +14155550100.
NEXT_PUBLIC_DEMO_PHONE=
# Optional overrides of the CRM booking calendars (defaults from docs/CRM_SETUP.md, in site.config.ts).
# Strategy Call (30 min).
NEXT_PUBLIC_CALENDAR_URL=
# Test Build Session (45 min, Demo Lab tab 4).
NEXT_PUBLIC_TESTBUILD_CALENDAR_URL=
# Cloudflare Turnstile site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Analytics (load only after cookie consent; nothing loads and no banner shows while all are empty).
# Google Tag Manager container ID (GTM-XXXXXXX). When set, set up GA4 inside GTM and leave NEXT_PUBLIC_GA_ID empty,
# so visits are not counted twice (the direct GA4 tag is skipped while a GTM ID is set).
NEXT_PUBLIC_GTM_ID=
# GA4 measurement ID (G-XXXXXXXXXX), used directly only when there is no GTM container.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
# Chat agent widget script URL (loaded on the Demo Lab only).
NEXT_PUBLIC_CHAT_WIDGET_SRC=
