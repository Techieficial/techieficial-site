# Copy to .env.local for local development. Never commit real values.
#
# In Cloudflare (Workers & Pages > techieficial-site > Settings):
#   NEXT_PUBLIC_* values are BUILD variables (Build > Variables and secrets), because they are baked into the pages at build time.
#   The others are runtime SECRETS (Variables and Secrets, type "Secret").

# --- Runtime secrets (server only) ---
# CRM inbound webhook that receives every form submission.
CRM_WEBHOOK_URL=
# Optional separate webhook that triggers the AI outbound "call me" demo. Falls back to CRM_WEBHOOK_URL.
CRM_CALLME_WEBHOOK_URL=
# Cloudflare Turnstile secret key (spam protection on forms).
TURNSTILE_SECRET_KEY=

# --- Build variables (public, shown in the browser) ---
# Business email shown in the footer and contact page.
NEXT_PUBLIC_CONTACT_EMAIL=
# Live AI receptionist demo number in international format, e.g. +14155550100.
NEXT_PUBLIC_DEMO_PHONE=
# CRM calendar embed URL for booking demos.
NEXT_PUBLIC_CALENDAR_URL=
# Cloudflare Turnstile site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Analytics (load only after cookie consent).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
# Chat agent widget script URL (loaded on the Demo Lab only).
NEXT_PUBLIC_CHAT_WIDGET_SRC=
