# Sanity Studio settings. Copy to studio/.env and fill in during B5. Never commit studio/.env.
# Only variables that start with SANITY_STUDIO_ are bundled into the Studio, and they are public
# (a project id and dataset name are not secrets). Never put an API token here.

# Project id from sanity.io/manage (lowercase letters and numbers). Created by the owner in M3.
SANITY_STUDIO_PROJECT_ID=

# Dataset name. Use "production" for the live site and "development" for testing.
SANITY_STUDIO_DATASET=

# App id printed by the first `npx sanity deploy` (hosted Studio). Optional until then.
SANITY_STUDIO_APP_ID=
